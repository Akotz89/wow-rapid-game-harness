+// stopWithError publishes the first cause and invalidates the stream atomically.
+func (w *WorldClient) stopWithError(err error) error {
+	w.sendMu.Lock()
+	if w.lastError == nil && !w.stopped {
+		w.lastError = err
+	}
+	if w.lastError != nil {
+		err = w.lastError
+	}
+	w.closeLocked()
+	w.sendMu.Unlock()
+	w.signalStop()
+	return err
+}

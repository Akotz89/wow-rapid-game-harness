+// writePacketLocked never reuses an uncertain stream, especially after cipher advancement.
+func (w *WorldClient) writePacketLocked(packet []byte) error {
+	if w.stopped || w.conn == nil {
+		return fmt.Errorf("not connected or stopped")
+	}
+	err := w.conn.SetWriteDeadline(time.Now().Add(4 * time.Second))
+	if err == nil {
+		var n int
+		n, err = w.conn.Write(packet)
+		if err == nil && n != len(packet) {
+			err = io.ErrShortWrite
+		}
+	}
+	if err != nil {
+		if w.lastError == nil {
+			w.lastError = fmt.Errorf("write world packet: %w", err)
+		}
+		w.closeLocked()
+		w.signalStop()
+		return w.lastError
+	}
+	return nil
 }
 

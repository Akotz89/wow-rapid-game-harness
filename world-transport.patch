+// StopError returns the first terminal cause, or nil if no stop is known.
+// Both the stopped bit and channel matter during Close's signal publication gap.
+func (w *WorldClient) StopError() error {
+	w.sendMu.Lock()
+	defer w.sendMu.Unlock()
+	select {
+	case <-w.stopChan:
+	default:
+		if !w.stopped {
+			return nil
+		}
+	}
+	if w.lastError != nil {
+		return w.lastError
+	}
+	return fmt.Errorf("client stopped")
 }
 
